# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Meta / Instagram
META_ACCESS_TOKEN=        # Facebook Page Access Token (60-day)
INSTAGRAM_USER_ID=        # IG Business Account ID (numeric)
META_APP_ID=              # From developers.facebook.com → App Settings → Basic
META_APP_SECRET=          # Same page, click Show

# Google Gemini (free tier)
GEMINI_API_KEY=           # From aistudio.google.com

# imgbb (free image hosting — Meta API needs public URLs)
IMGBB_API_KEY=            # From api.imgbb.com

# Supabase (free Postgres database)
SUPABASE_URL=             # https://xxxx.supabase.co
SUPABASE_KEY=             # service_role key (Settings → API)
