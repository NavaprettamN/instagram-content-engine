# Copy to .env.local for local dev; set the same as Environment Variables in Vercel.

# Auth.js (v5). Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application). Auth.js auto-reads these names.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only these emails can sign in (comma-separated). Leave blank = allow any Google
# account (NOT recommended).
ALLOWED_EMAILS=navaprettam.n214@gmail.com

# Supabase — SERVER-ONLY. The service_role key stays here (never shipped to the
# browser). Same values as the pipeline's secrets.
SUPABASE_URL=
SUPABASE_KEY=

# Optional: GitHub PAT with `workflow` scope so the Controls page can trigger
# runs (research/generate/publish/meme). Leave blank to hide manual triggers.
GH_PAT=
GH_REPO=NavaprettamN/instagram-content-engine
